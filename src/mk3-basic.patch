+    if (req->Translation && req->Translation->PanTilt) {
+        float tsign = is_hang_mode() ? -1.0f : 1.0f;
+        const float dpan  = req->Translation->PanTilt->x * REL_SCALE_PAN;
+        const float dtilt = req->Translation->PanTilt->y * tsign * REL_SCALE_TILT;
