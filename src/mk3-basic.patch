+    if(!soap->mustUnderstand)
+        return SOAP_OK;                          // 예전과 같음: 모르는 요소는 건너뜀
+
+    if(soap->part == SOAP_IN_HEADER && is_wsse_security(soap, tag))
+        return SOAP_OK;                          // 내용은 mk3_authorize 가 받은 원문에서 읽는다
