+            adjust_current_pt(dpan, dtilt);
+            goto_current_pt();
+        }
+    }
+    if (req->Translation && req->Translation->Zoom) {
+        const float dzoom = req->Translation->Zoom->x * REL_SCALE_ZOOM;
+        if (dzoom != 0.0f) {
+            zoom_current_fresh();          // 실제 줌을 기준으로 더한다 (안 그러면 줌이 튐)
+            adjust_current_zoom(dzoom);
